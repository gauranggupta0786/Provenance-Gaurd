{
  "$defs": {
    "CallStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "CallStatus",
      "type": "string"
    },
    "EvaluationRecord": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "baseline",
            "protected"
          ],
          "title": "Arm",
          "type": "string"
        },
        "attack_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attack Success"
        },
        "benign_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benign Success"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evaluator_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "final_state_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final State Digest"
        },
        "graph_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Graph Run Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "evaluation-record-v1",
          "default": "evaluation-record-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        }
      },
      "required": [
        "graph_run_id",
        "scenario_id",
        "arm",
        "seed",
        "status",
        "completed",
        "evaluator_version"
      ],
      "title": "EvaluationRecord",
      "type": "object"
    },
    "EvaluationStatus": {
      "enum": [
        "EVALUABLE",
        "ERROR"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "ExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "approval_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "idempotency_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "schema_version": {
          "const": "execution-record-v1",
          "default": "execution-record-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "required": [
        "attempt_id",
        "proposal_id",
        "approval_id",
        "idempotency_key",
        "adapter",
        "status",
        "started_at"
      ],
      "title": "ExecutionRecord",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "RESERVED",
        "SUCCEEDED",
        "FAILED",
        "UNCERTAIN"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "call_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "graph_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Graph Run Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "request_evidence_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Request Evidence Ref",
          "type": "string"
        },
        "response_evidence_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Evidence Ref"
        },
        "schema_version": {
          "const": "model-call-v1",
          "default": "model-call-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "HEALTHCHECK",
            "WARMUP",
            "CALL_MODEL"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CallStatus"
        }
      },
      "required": [
        "call_id",
        "graph_run_id",
        "profile_sha256",
        "stage",
        "attempt",
        "request_evidence_ref",
        "latency_ms",
        "status"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "NodeDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "graph_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Graph Run Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "node": {
          "$ref": "#/$defs/WorkflowNode"
        },
        "schema_version": {
          "const": "graph-node-diagnostic-v1",
          "default": "graph-node-diagnostic-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "started_at": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "INTERRUPTED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "graph_run_id",
        "node",
        "sequence",
        "started_at",
        "latency_ms",
        "status"
      ],
      "title": "NodeDiagnostic",
      "type": "object"
    },
    "PolicyDecision": {
      "enum": [
        "ALLOW",
        "REQUIRE_APPROVAL",
        "DENY"
      ],
      "title": "PolicyDecision",
      "type": "string"
    },
    "PolicyOutcome": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "evaluated_at": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evaluated At",
          "type": "string"
        },
        "phase": {
          "enum": [
            "proposal",
            "execution"
          ],
          "title": "Phase",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "proposal_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "policy-outcome-v1",
          "default": "policy-outcome-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "decision",
        "reason",
        "policy_version",
        "evaluated_at"
      ],
      "title": "PolicyOutcome",
      "type": "object"
    },
    "ReceiptRecord": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Digest",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "created_at": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 16384,
          "title": "Detail",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "result_status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Result Status",
          "type": "string"
        },
        "schema_version": {
          "const": "receipt-record-v1",
          "default": "receipt-record-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "proposal_id",
        "idempotency_key",
        "action_digest",
        "result_status",
        "result_digest",
        "created_at"
      ],
      "title": "ReceiptRecord",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "CREATED",
        "RUNNING",
        "INTERRUPTED",
        "RETRYABLE",
        "REJECTED",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "observed_at": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "raw_evidence_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Evidence Ref"
        },
        "schema_version": {
          "const": "source-evidence-v1",
          "default": "source-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_type": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "trust_label": {
          "enum": [
            "trusted",
            "untrusted"
          ],
          "title": "Trust Label",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "tenant_id",
        "source_type",
        "source_identity",
        "trust_label",
        "content_digest",
        "version",
        "observed_at"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "ToolClass": {
      "enum": [
        "READ",
        "WRITE"
      ],
      "title": "ToolClass",
      "type": "string"
    },
    "ToolIntent": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "propertyNames": {
                "maxLength": 160,
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Arguments"
        },
        "call_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "parse_error": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parse Error"
        },
        "raw_arguments": {
          "$ref": "#/$defs/JsonValue"
        },
        "schema_version": {
          "const": "tool-intent-v1",
          "default": "tool-intent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_response_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Response Id"
        },
        "tool_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_name",
        "arguments",
        "raw_arguments"
      ],
      "title": "ToolIntent",
      "type": "object"
    },
    "WorkflowNode": {
      "enum": [
        "START",
        "LOAD_SCENARIO",
        "BUILD_CONVERSATION",
        "CALL_MODEL",
        "PARSE_TOOL_INTENT",
        "CLASSIFY_TOOL",
        "EXECUTE_READ",
        "LABEL_SOURCES",
        "VALIDATE_WRITE",
        "EVALUATE_POLICY",
        "REJECT_AND_AUDIT",
        "BUILD_AND_SIGN_PROPOSAL",
        "OBTAIN_APPROVAL",
        "GATEWAY_REVALIDATE",
        "CONSUME_AND_RESERVE",
        "EXECUTE_ADAPTER",
        "PERSIST_RECEIPT",
        "EVALUATE_FINAL_STATE",
        "END"
      ],
      "title": "WorkflowNode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "arm": {
      "enum": [
        "baseline",
        "protected"
      ],
      "title": "Arm",
      "type": "string"
    },
    "conversation_evidence_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Evidence Ref"
    },
    "current_node": {
      "$ref": "#/$defs/WorkflowNode",
      "default": "START"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "graph_run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Graph Run Id",
      "type": "string"
    },
    "last_error": {
      "anyOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "model_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCallRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Profile Sha256",
      "type": "string"
    },
    "node_diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NodeDiagnostic"
      },
      "maxItems": 256,
      "title": "Node Diagnostics",
      "type": "array"
    },
    "path": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "maxItems": 256,
      "title": "Path",
      "type": "array"
    },
    "policy_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "principal_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "proposal_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReceiptRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_count": {
      "default": 0,
      "enum": [
        0,
        1
      ],
      "title": "Retry Count",
      "type": "integer"
    },
    "scenario_evidence_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Scenario Evidence Ref",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-run-state-v1",
      "default": "agent-run-state-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "source_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceEvidence"
      },
      "maxItems": 64,
      "title": "Source Evidence",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "CREATED"
    },
    "tool_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "graph_run_id",
    "scenario_id",
    "arm",
    "seed",
    "session_id",
    "principal_id",
    "model_profile_sha256",
    "scenario_evidence_ref"
  ],
  "title": "AgentRunState",
  "type": "object"
}
