{
  "$defs": {
    "EvaluationStatus": {
      "enum": [
        "EVALUABLE",
        "ERROR"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arm": {
      "enum": [
        "baseline",
        "protected"
      ],
      "title": "Arm",
      "type": "string"
    },
    "attack_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attack Success"
    },
    "benign_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benign Success"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "evaluator_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "final_state_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final State Digest"
    },
    "graph_run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Graph Run Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation-record-v1",
      "default": "evaluation-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/EvaluationStatus"
    }
  },
  "required": [
    "graph_run_id",
    "scenario_id",
    "arm",
    "seed",
    "status",
    "completed",
    "evaluator_version"
  ],
  "title": "EvaluationRecord",
  "type": "object"
}
