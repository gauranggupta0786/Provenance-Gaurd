{
  "$defs": {
    "ExecutionStatus": {
      "enum": [
        "RESERVED",
        "SUCCEEDED",
        "FAILED",
        "UNCERTAIN"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Adapter",
      "type": "string"
    },
    "approval_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "execution-record-v1",
      "default": "execution-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    }
  },
  "required": [
    "attempt_id",
    "proposal_id",
    "approval_id",
    "idempotency_key",
    "adapter",
    "status",
    "started_at"
  ],
  "title": "ExecutionRecord",
  "type": "object"
}
